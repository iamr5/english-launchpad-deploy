# Copia este archivo a `keystore.properties` (sin .example) y rellénalo.
#
# `keystore.properties` y el propio .jks están en .gitignore. NO los subas:
# con la clave de firma, cualquiera puede publicar una actualización de la app
# en tu nombre.
#
# Sin este archivo, `assembleDebug` sigue funcionando —para probar en un móvil
# no hace falta la clave—; sólo `bundleRelease` la necesita.
#
# La ruta es relativa a la carpeta android/.

storeFile=aprendoenglish.jks
storePassword=
keyAlias=aprendoenglish
keyPassword=
