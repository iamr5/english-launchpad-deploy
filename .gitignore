# .gitmodules, apuntando a commits que solo existen en local).
.claude/worktrees/

# ── App nativa (Capacitor) ────────────────────────────────────────────────
#
# android/ SÍ va al repositorio desde que tiene cosas escritas a mano que
# `npx cap add android` no reconstruiría:
#
#   · el filtro de intent del enlace profundo (la vuelta del login de Google)
#   · el permiso de micrófono (la práctica de speaking)
#   · la configuración de firma de release
#
# Antes se ignoraba, cuando todo su contenido salía de capacitor.config.ts.
# Regenerarlo ahora perdería las tres cosas, y ninguna falla al compilar: se
# descubriría en el móvil, o peor, en la revisión de la tienda.
#
# Lo que sigue fuera es lo que produce la compilación, lo que depende de la
# máquina y —sobre todo— la clave.
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/release/

# La clave de firma y sus contraseñas NUNCA van al repositorio. Perderla es no
# poder volver a actualizar la app en Play; filtrarla es que otro publique
# actualizaciones en tu nombre.
android/keystore.properties
*.keystore
*.jks

# El proyecto de iOS lo genera `npx cap add ios` en un Mac. Todavía no se ha
# empezado: por ahora sólo Play.
ios/

# El proyecto de iOS lo genera `npx cap add ios` en un Mac. Sus artefactos:
ios/App/Pods/
ios/App/App/public/
ios/App/build/
ios/.gradle/
DerivedData/
